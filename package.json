{
  "name": "gdpr-customer-erasure-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "astra:validate": "python3 scripts/validate_task.py tasks",
    "astra:build:images": "python3 scripts/build_images.py",
    "astra:generate": "python3 -m astra_harness.generate",
    "astra:verify": "python3 -m astra_harness.verify",
    "astra:score": "python3 -m astra_harness.score",
    "astra:package": "python3 scripts/package_task.py",
    "astra:check:package": "python3 readiness_checks/check_package.py",
    "astra:check:acceptance": "python3 readiness_checks/check_acceptance.py",
    "astra:check:scoring": "python3 readiness_checks/check_scoring.py",
    "astra:check:determinism": "python3 readiness_checks/check_determinism.py",
    "astra:check:proof": "python3 readiness_checks/check_proof_work.py",
    "astra:check:reference": "python3 readiness_checks/check_reference.py --proof-dir verifier/proof-of-work",
    "astra:check:mutants": "python3 readiness_checks/check_mutants.py --verifier-dir verifier --proof-dir verifier/proof-of-work",
    "candidates:run": "npx --prefix codebase tsx scripts/candidates/start-container.ts",
    "candidates:generate:codex": "npx --prefix codebase tsx scripts/candidates/generate.ts --provider codex-login",
    "candidates:generate:portkey": "npx --prefix codebase tsx scripts/candidates/generate.ts --provider portkey",
    "candidates:generate:portkey-opencode": "npx --prefix codebase tsx scripts/candidates/generate.ts --provider portkey-opencode",
    "candidates:smoke:portkey-opencode": "npx --prefix codebase tsx scripts/candidates/portkey-opencode-smoke.ts",
    "candidates:status": "npx --prefix codebase tsx scripts/candidates/status-container.ts",
    "candidates:finalize": "npx --prefix codebase tsx scripts/candidates/finalize-container.ts",
    "candidates:score": "bash scripts/candidates/score.sh",
    "candidates:summary": "npx --prefix codebase tsx scripts/candidates/summary.ts"
  }
}
